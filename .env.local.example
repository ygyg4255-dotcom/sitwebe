# ─────────────────────────────────────────────────────────────
# SiteWib — environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash) — used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 2 — database, auth, storage) ──
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (Phase 5 — notification e-mails to the agency on new bookings
#    and contact inquiries). Optional: without these, sending is skipped
#    gracefully and the site works normally. ──
# From: resend.com → API Keys
RESEND_API_KEY=
# Verified sender address, e.g. notifications@your-agency.com
RESEND_FROM_EMAIL=